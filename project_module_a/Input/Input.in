#Number of Run
4
#Dim of X
2.0*pi

#Dim of Y
2.0*pi

#Dim of Z
2.0*pi

# Number of mesh points in X, Y, Z directions (Nx, Ny, Nz)
8 8 8

# Time step size (dt)
2e-5

# Total simulation time (T)   25 time step
5e-4

# boundary velocity
./Input/boundary_u0.dat

# boundary pressure
./Input/boundary_p0.dat

# fx forcing term
cos(t)*sin(x)*sin(y)*sin(z)+(3.0*1e-1)*sin(t)*sin(x)*sin(y)*sin(z)+(1e-1)*sin(x)*sin(y)*sin(z)*sin(t)+sin(t)*cos(x)*sin(y)*sin(z)

# fy forcing term
cos(t)*cos(x)*cos(y)*cos(z)+(3.0*1e-1)*sin(t)*cos(x)*cos(y)*cos(z)+(1e-1)*cos(x)*cos(y)*cos(z)*sin(t)+sin(t)*sin(x)*cos(y)*sin(z)

# fz forcing term
cos(t)*cos(x)*sin(y)*(sin(z)+cos(z))+(3.0*1e-1)*cos(x)*sin(y)*(cos(z)+sin(z))+(1e-1)*sin(t)*cos(x)*sin(y)*(sin(z)+cos(z))+sin(t)*sin(x)*sin(y)*cos(z)

# u_initial condition term
sin(t)*sin(x)*sin(y)*sin(z)

# v initial condition term
sin(t)*cos(x)*cos(y)*cos(z)

# w initial conditino term
sin(t)*cos(x)*sin(y)*(sin(z)+cos(z))

# p initial condition term
sin(t)*sin(x)*sin(y)*sin(z)

# k
1.0

# nu
1e-1