#Number of Run
1

#Dim of X 
2.0*3.141592653

#Dim of Y 
2.0*3.141592653

#Dim of Z 
2.0*3.141592653

# Number of mesh points in X, Y, Z directions (Nx, Ny, Nz)
10 10 10

# Time step size (dt)
0.0001

# Total simulation time (T)
0.0003



# boundary velocity
./Input/boundary_u0.dat
# boundary pressure
./Input/boundary_p0.dat

# fx forcing term
cos(t)*sin(x)*sin(y)*sin(z)+sin(t)*((21+6e-10)*sin(x)*sin(y)*sin(z)-3*sin(x)*sin(y)*cos(z))

# fy forcing term
cos(t)*cos(x)*cos(y)*cos(z)+sin(t)*((21+6e-10)*cos(x)*cos(y)*cos(z)-3*cos(x)*cos(y)*sin(z)) 

# fz forcing term
cos(t)*cos(x)*sin(y)*(sin(z)+cos(z))+sin(t)*((15+6e-10)*cos(x)*sin(y)*(sin(z)+cos(z)))

# u_initial condition term
sin(t)*sin(x)*sin(y)*sin(z)

# v initial condition term
sin(t)*cos(x)*cos(y)*cos(z)

# w initial conditino term
sin(t)*cos(x)*sin(y)*(sin(z)+cos(z))

# p initial condition term
-sin(t)*3.0*cos(x)*sin(y)*(sin(z)-cos(z))

# k 
1e10

# nu 
6.0