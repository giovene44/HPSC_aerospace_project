#Number of Run
4

#Dim of X
2*pi

#Dim of Y
2*pi

#Dim of Z
2*pi

# Number of mesh points in X, Y, Z directions (Nx, Ny, Nz)
10 10 10

# Time step size (dt)
0.0025

# Total simulation time (T)
1.0

# boundary velocity
./Input/boundary_u0.dat
# boundary pressure
./Input/boundary_p0.dat

# fx forcing term
cos(t)*sin(x)*sin(y)*sin(z)+(3*1e-1)*sin(t)*sin(x)*sin(y)*sin(z)

# fy forcing term
cos(t)*cos(x)*cos(y)*cos(z)+(3*1e-1)*sin(t)*cos(x)*cos(y)*cos(z)

# fz forcing term
cos(t)*cos(x)*sin(y)*(cos(z)+sin(z))+(3*1e-1)*(sin(t)*cos(x)*sin(y)*(cos(z)+sin(z)))

# u_initial condition term
sin(t)*sin(x)*sin(y)*sin(z)

# v initial condition term
sin(t)*cos(x)*cos(y)*cos(z)

# w initial conditino term
sin(t)*cos(x)*sin(y)*(sin(z)+cos(z))

# p initial condition term
sin(t)*2*1e-1*cos(x)*sin(y)*(sin(z)-cos(z))

# k
1.0e10

# nu
1e-1
